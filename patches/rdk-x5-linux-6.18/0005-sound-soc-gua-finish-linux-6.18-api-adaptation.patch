From: Codex <codex@openai.com>
Subject: [PATCH] ASoC: gua: finish Linux 6.18 platform and DAI format adaptation

Convert the remaining platform remove callback to the Linux 6.18 void
signature.  Also replace the removed controller/peripheral-era
SND_SOC_DAIFMT_CBS_CFS name with its equivalent provider/consumer spelling,
SND_SOC_DAIFMT_CBC_CFC (codec consumes both clocks).
---
 sound/soc/gua/gua-machine.c  | 12 ++++++------
 sound/soc/gua/gua_misc_drv.c |  8 +++-----
 2 files changed, 9 insertions(+), 11 deletions(-)

diff --git a/sound/soc/gua/gua_misc_drv.c b/sound/soc/gua/gua_misc_drv.c
index 4c2b059d1..4d4dfc5e4 100644
--- a/sound/soc/gua/gua_misc_drv.c
+++ b/sound/soc/gua/gua_misc_drv.c
@@ -441,10 +441,10 @@ static s32 gua_audio_misc_probe(struct platform_device *pdev)
-static s32 gua_audio_misc_remove(struct platform_device *pdev)
+static void gua_audio_misc_remove(struct platform_device *pdev)
 {
 	gua_audio_misc_info_t *gua_misc_priv = dev_get_drvdata(&pdev->dev);
 
 	if (IS_ERR_OR_NULL(gua_misc_priv)) {
 		dev_err(&pdev->dev, "gua_misc_priv is null.\n");
-		return -EFAULT;
+		return;
 	}
 
 	misc_deregister(&gua_misc_priv->misc_dev);
@@ -456,7 +456,5 @@ static void gua_audio_misc_remove(struct platform_device *pdev)
 	devm_kfree(&pdev->dev, gua_misc_priv);
 	dev_set_drvdata(&pdev->dev, NULL);
-
-	return 0;
 }
 
 static const struct of_device_id gua_audio_misc_ids[] = {
diff --git a/sound/soc/gua/gua-machine.c b/sound/soc/gua/gua-machine.c
index c7cdf3b8a..3dbb09550 100644
--- a/sound/soc/gua/gua-machine.c
+++ b/sound/soc/gua/gua-machine.c
@@ -40 +40 @@ static struct snd_soc_dai_link gua_dai_links[] = {
-		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBS_CFS,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC,
@@ -50 +50 @@ static struct snd_soc_dai_link gua_dai_links[] = {
-		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBS_CFS,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC,
@@ -60 +60 @@ static struct snd_soc_dai_link gua_dai_links[] = {
-		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBS_CFS,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC,
@@ -70 +70 @@ static struct snd_soc_dai_link gua_dai_links[] = {
-		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBS_CFS,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC,
@@ -80 +80 @@ static struct snd_soc_dai_link gua_dai_links[] = {
-		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBS_CFS,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC,
@@ -90 +90 @@ static struct snd_soc_dai_link gua_dai_links[] = {
-                .dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBS_CFS,
+                .dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC,
-- 
