From 01339d94bccde8b5750bf23458339f91798f5618 Mon Sep 17 00:00:00 2001
From: huaiyuhorizon <huaiyu.zhang@d-robotics.cc>
Date: Wed, 15 Apr 2026 10:39:07 +0800
Subject: [PATCH 2/2] optimize: Change task join function from 'destructor' to
 'stop'; add 'std::endl' to output log for print function

---
 include/x5/hobot_mipi_cap_iml.hpp | 17 +----------------
 src/hobot_mipi_node.cpp           |  3 ++-
 src/x5/hobot_mipi_cap_iml.cpp     | 13 +++++++++++++
 3 files changed, 16 insertions(+), 17 deletions(-)

diff --git a/include/x5/hobot_mipi_cap_iml.hpp b/include/x5/hobot_mipi_cap_iml.hpp
index 15113e5..6bbe61d 100755
--- a/include/x5/hobot_mipi_cap_iml.hpp
+++ b/include/x5/hobot_mipi_cap_iml.hpp
@@ -77,22 +77,7 @@ typedef struct pipe_contex_s {
 class HobotMipiCapIml : public HobotMipiCap {
  public:
   HobotMipiCapIml() {}
-  ~HobotMipiCapIml() {
-    // Safety cleanup: ensure threads are joined before destruction
-    started_ = false;
-    if (multi_frame_task_ && multi_frame_task_->joinable()) {
-      multi_frame_task_->join();
-    }
-    if (sync_task_ && sync_task_->joinable()) {
-      sync_task_->join();
-    }
-    if (sub_multi_frame_task_ && sub_multi_frame_task_->joinable()) {
-      sub_multi_frame_task_->join();
-    }
-    if (sub_sync_task_ && sub_sync_task_->joinable()) {
-      sub_sync_task_->join();
-    }
-  }
+  ~HobotMipiCapIml() {}
 
   // 初始化设备环境，如X3的sensor GPIO配置和时钟配置
   // 返回值：0，成功；-1，配置失败
diff --git a/src/hobot_mipi_node.cpp b/src/hobot_mipi_node.cpp
index cb89e04..b380888 100755
--- a/src/hobot_mipi_node.cpp
+++ b/src/hobot_mipi_node.cpp
@@ -179,7 +179,7 @@ MipiCamNode::MipiCamNode(const rclcpp::NodeOptions& node_options)
   );
 
   init();
-
+  std::cout << std::endl;
 }
 
 MipiCamNode::~MipiCamNode() {
@@ -211,6 +211,7 @@ MipiCamNode::~MipiCamNode() {
     timer->join();
   }
   imu_timer_.clear();
+  std::cout << std::endl;
 }
 
 void MipiCamNode::init() {
diff --git a/src/x5/hobot_mipi_cap_iml.cpp b/src/x5/hobot_mipi_cap_iml.cpp
index 218553e..cca5d1b 100755
--- a/src/x5/hobot_mipi_cap_iml.cpp
+++ b/src/x5/hobot_mipi_cap_iml.cpp
@@ -473,7 +473,20 @@ int HobotMipiCapIml::stop() {
       "x5 camera isn't started");
     return -1;
   }
+  // Safety cleanup: ensure threads are joined before destruction
   started_ = false;
+  if (multi_frame_task_ && multi_frame_task_->joinable()) {
+    multi_frame_task_->join();
+  }
+  if (sync_task_ && sync_task_->joinable()) {
+    sync_task_->join();
+  }
+  if (sub_multi_frame_task_ && sub_multi_frame_task_->joinable()) {
+    sub_multi_frame_task_->join();
+  }
+  if (sub_sync_task_ && sub_sync_task_->joinable()) {
+    sub_sync_task_->join();
+  }
   for(auto contex : pipe_contex){
     ret = hbn_vflow_stop(contex.vflow_fd);
     ERR_CON_EQ(ret, 0);
-- 
2.53.0

