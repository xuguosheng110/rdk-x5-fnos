From: Codex <noreply@openai.com>
Subject: [PATCH] sysinfopro: probe optional libraries at runtime

The system information tool only needs version strings from most HBRE
libraries, but directly linking every library makes the entire utility fail
when any optional library has an incompatible dependency.  This is currently
visible with the OpenSSL 1.1 based te600 engine and the libgpiod 2 based efuse
library on the Ubuntu 22.04 image.

Keep boardinfo as the sole functional dependency and load each version symbol
independently.  A missing or incompatible optional component is now reported
as unavailable without hiding the remaining system information.
---
 sysinfopro/Makefile     |  6 +----
 sysinfopro/sysinfopro.c | 98 +++++++++++++++++++++++--------------------------
 sysinfopro/sysinfopro.h | 19 ----------
 3 files changed, 47 insertions(+), 76 deletions(-)

diff --git a/sysinfopro/sysinfopro.c b/sysinfopro/sysinfopro.c
index 1111111..2222222 100644
--- a/sysinfopro/sysinfopro.c
+++ b/sysinfopro/sysinfopro.c
@@ -3,7 +3,7 @@
 #include <string.h>
 #include <sys/stat.h>
 #include <errno.h>
-#include <openssl/evp.h>
+#include <dlfcn.h>
 #include "sysinfopro.h"
 #include "boardinfo.h"
 
@@ -375,64 +375,68 @@ void get_board_info() {
 	}
 	printf("\n");
 }
+
+typedef const char *(*version_fn_t)(void);
+
+static void print_library_version(const char *label, const char *library,
+		const char *symbol) {
+	void *handle;
+	version_fn_t version_fn;
+	const char *error;
+	const char *version;
+
+	handle = dlopen(library, RTLD_LAZY | RTLD_LOCAL);
+	if (handle == NULL) {
+		printf("\t%-30s Unavailable (%s)\n", label, dlerror());
+		return;
+	}
 
+	dlerror();
+	*(void **)(&version_fn) = dlsym(handle, symbol);
+	error = dlerror();
+	if (error != NULL) {
+		printf("\t%-30s Unavailable (%s)\n", label, error);
+		dlclose(handle);
+		return;
+	}
+
+	version = version_fn();
+	printf("\t%-30s %s\n", label, version != NULL ? version : "Unknown");
+	dlclose(handle);
+}
+
