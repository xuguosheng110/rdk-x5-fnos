+		{"libvpf", "libvpf.so", "hb_libvpf_get_version_info"},
+		{"libdsp", "libdsp.so", "hb_libdsp_get_version_info"},
+		{"libboardinfo", "libboardinfo.so", "hb_libboardinfo_get_version_info"},
+		{"libefuse", "libefuse.so", "hb_libefuse_get_version_info"},
+		{"libhbmem", "libhbmem.so", "hb_libhbmem_get_version_info"},
+		{"libhbipcfhal", "libhbipcfhal.so", "hb_libhbipcfhal_get_version_info"},
+		{"libalog", "libalog.so", "hb_libalog_get_version_info"},
+		{"libmultimedia", "libmultimedia.so", "hb_libmultimedia_get_version_info"},
+		{"libte600_engine", "libte600_engine.so", "hb_libte600_engine_get_version_info"},
+		{"libupdate", "libupdate.so", "hb_libupdate_get_version_info"},
+		{"libpowerctl", "libpowerctl.so", "hb_libpowerctl_get_version_info"},
+		{"libsecure_storage", "libsecure_storage.so", "hb_libsecure_storage_get_version_info"},
+		{"libhbplayer", "libhbplayer.so", "hb_libhbplayer_get_version_info"},
+		{"libdnn", "libdnn.so", "hbDNNGetVersion"},
+		{"gc8000l", "/usr/hobot/lib/libEGL.so", "gc8000l_get_version_info"},
+		{"x5_camsys", "libhal.so", "hb_libhal_get_version_info"},
+		{"libNano2D/libNano2Dutil", "libNano2D.so", "n2d_get_version_info"},
+	};
 
 	printf("[HBRE lib version]:\n");
-	printf("\t%-30s %s\n", "libcam", libcam_version_info);
-	printf("\t%-30s %s\n", "libvpf", libvpf_version_info);
-	printf("\t%-30s %s\n", "libdsp", libdsp_version_info);
-	printf("\t%-30s %s\n", "libboardinfo", libboardinfo_version_info);
-	printf("\t%-30s %s\n", "libefuse", libefuse_version_info);
-	printf("\t%-30s %s\n", "libhbmem", libhbmem_version_info);
-	printf("\t%-30s %s\n", "libhbipcfhal", libhbipcfhal_version_info);
-	printf("\t%-30s %s\n", "libalog", libalog_version_info);
-	printf("\t%-30s %s\n", "libmultimedia", libmultimedia_version_info);
-	printf("\t%-30s %s\n", "libte600_engine", libte600_engine_version_info);
-	printf("\t%-30s %s\n", "libupdate", libupdate_version_info);
-	printf("\t%-30s %s\n", "libpowerctl", libpowerctl_version_info);
-	printf("\t%-30s %s\n", "libsecure_storage", libsecure_storage_version_info);
-	printf("\t%-30s %s\n", "libhbplayer", libhbplayer_version_info);
-	printf("\t%-30s %s\n", "libdnn", libdnn_version_info);
-	printf("\t%-30s %s\n", "gc8000l", gc8000l_version_info);
-	printf("\t%-30s %s\n", "x5_camsys", x5_camsys_libs_version_info);
-	printf("\t%-30s %s\n\n", "libNano2D/libNano2Dutil", libNano2D_version_info);
+	for (size_t i = 0; i < sizeof(libraries) / sizeof(libraries[0]); i++) {
+		print_library_version(libraries[i].label, libraries[i].library,
+				libraries[i].symbol);
+	}
+	printf("\n");
 }
 
